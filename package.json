{
  "name": "canvas",
  "version": "0.4.0",
  "private": true,
  "description": "A visual conversation tree for AI chats: branch, revisit and follow any thread. Runs on your own machine with your own key from OpenAI, Anthropic, Gemini, DeepSeek, OpenRouter, Ollama or any OpenAI-compatible provider.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node --test tests/browser.test.mjs",
    "catalog": "tsx scripts/update-catalog.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "d3-force": "^3.0.0",
    "docx-preview": "^0.4.1",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.0",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math-extended": "^6.1.1",
    "tsx": "^4.23.15",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jszip": "^3.10.2",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
