# Optional. Copy to .env (git-ignored) to set any of these. Variables already
# exported in your shell (such as OPENAI_API_KEY) connect too. Each provider
# bills its own account; see the Providers table in README.md.

# Connect providers at startup instead of entering keys in the app.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# ZAI_API_KEY=
# ZAI_CODING_CN_API_KEY=
# Qwen: pay-as-you-go, or a Token Plan.
# DASHSCOPE_API_KEY=
# QWEN_TOKEN_PLAN_API_KEY=
# QWEN_TOKEN_PLAN_CN_API_KEY=
# Xiaomi MiMo: API billing, or a regional Token Plan.
# XIAOMI_API_KEY=
# XIAOMI_TOKEN_PLAN_CN_API_KEY=
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=
# ANT_LING_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# BASETEN_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# OPENROUTER_API_KEY=
# Vercel AI Gateway.
# AI_GATEWAY_API_KEY=
# OPENCODE_API_KEY=

# Cloudflare Workers AI; add CLOUDFLARE_GATEWAY_ID for AI Gateway.
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=

# Azure OpenAI: a resource name or a full base URL.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# Local servers connect without a key when their address is set.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Or Ollama Cloud.
# OLLAMA_API_KEY=
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Any other OpenAI-compatible server (vLLM, llama.cpp, LiteLLM, ...).
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# Another port if 3000 is busy.
# PORT=3001

# Where canvases are saved. Use an absolute path. Defaults to
# ~/Library/Application Support/Canvas (macOS), %APPDATA%\Canvas (Windows)
# or $XDG_DATA_HOME/canvas, else ~/.local/share/canvas (Linux).
# CANVAS_DATA_DIR=/absolute/path/to/Canvas
